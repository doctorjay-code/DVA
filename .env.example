# DVA 환경 변수 설정 템플릿
# 이 파일을 복사하여 .env 로 이름을 변경한 뒤 본인의 키를 입력하세요.
# (실제 .env 파일은 .gitignore에 의해 GitHub에 올라가지 않습니다)

# Supabase 클라우드 데이터베이스 설정 (퀴즈/설문 실시간 동기화)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# 슬랙 알림 설정 (선택 사항: settings.json 대신 환경변수 사용 시)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=...
